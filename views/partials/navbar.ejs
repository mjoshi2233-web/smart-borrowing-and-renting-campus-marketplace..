<header class="site-header">
  <nav class="navbar navbar-expand-lg container py-3" aria-label="Main navigation">
    <a class="navbar-brand brand" href="/">
      <span class="brand-mark"><i data-lucide="graduation-cap" class="brand-cap"></i><i data-lucide="shopping-cart" class="brand-cart"></i></span>
      <span class="brand-copy"><strong>CampusMart</strong><small>Buy <span>•</span> Sell <span>•</span> Connect</small></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
      <i data-lucide="menu"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNavigation">
      <form class="nav-search mx-lg-auto my-3 my-lg-0" action="/items/ai-search" method="post" role="search">
        <i data-lucide="search"></i>
        <label class="visually-hidden" for="navSearch">Search campus listings</label>
        <input id="navSearch" name="q" type="search" placeholder="Search campus listings">
        <button type="submit" aria-label="Search"><i data-lucide="arrow-right"></i></button>
      </form>
      <ul class="navbar-nav gap-lg-2">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/items') ? 'active' : '' %>" href="/items">Browse</a></li>
        <li class="nav-item"><a class="nav-link" href="/#categories">Categories</a></li>
      </ul>
      <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0 ms-lg-3">
        <% if (user) { %>
          <% if (user.role === 'admin') { %><a class="btn btn-link btn-sm text-decoration-none text-dark" href="/admin">Admin</a><% } %>
          <a class="profile-link" href="/dashboard"><span class="profile-icon"><i data-lucide="user-round"></i></span><span class="d-none d-xl-inline">My dashboard</span></a>
          <form action="/logout" method="post"><button class="btn btn-outline-secondary btn-sm" type="submit">Log out</button></form>
        <% } else { %>
          <a class="btn btn-link btn-sm text-decoration-none text-dark" href="/login">Log in</a>
          <a class="btn btn-primary btn-sm px-3" href="/register">Join CampusMart</a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
