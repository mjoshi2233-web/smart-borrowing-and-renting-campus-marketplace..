<%- include("partials/head", { title }) %>
<%- include("partials/navbar") %>
<main class="container page-space">
  <%- include("partials/alerts") %>
  <div class="dashboard-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
    <div class="page-intro mb-0"><span class="eyebrow">Your space</span><h1 class="page-title mt-2">Hello, <%= user.full_name.split(' ')[0] %></h1><p>Keep track of the things you share and borrow.</p></div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#listingModal"><i data-lucide="plus" class="icon-sm me-1"></i> Add a listing</button>
  </div>

  <div class="row g-3 my-4">
    <div class="col-md-4"><article class="stat-card"><span>Your listings</span><strong><%= stats.listing_count %></strong></article></div>
    <div class="col-md-4"><article class="stat-card"><span>Available now</span><strong><%= stats.available_count %></strong></article></div>
    <div class="col-md-4"><article class="stat-card"><span>Pending requests</span><strong><%= receivedRequests.filter(request => request.status === 'pending').length %></strong></article></div>
  </div>

  <section class="dashboard-section mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3"><div><span class="eyebrow">What you share</span><h2 class="h5 fw-semibold mt-1 mb-0">Your listings</h2></div></div>
    <% if (listings.length) { %>
      <div class="table-responsive surface-card"><table class="table align-middle mb-0">
        <thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Requests</th><th>Status</th><th>Action</th></tr></thead>
        <tbody><% listings.forEach(item => { %><tr>
          <td><a class="table-item-link" href="/items/<%= item.id %>"><%= item.title %></a></td><td><%= item.category_name %></td><td><%= formatPrice(item.price_per_day) %></td><td><%= item.pending_count %></td>
          <td><span class="status-pill <%= item.is_available ? 'status-available' : 'status-paused' %>"><%= item.is_available ? 'Available' : 'Paused' %></span></td>
          <td><form action="/listings/<%= item.id %>/availability" method="post"><input type="hidden" name="is_available" value="<%= item.is_available ? 'false' : 'true' %>"><button class="btn btn-sm btn-outline-primary" type="submit"><%= item.is_available ? 'Pause' : 'Relist' %></button></form></td>
        </tr><% }) %></tbody>
      </table></div>
    <% } else { %>
      <div class="empty-state compact-empty"><i data-lucide="package-open"></i><h3>Nothing shared yet</h3><p>Add your first listing to help someone on campus.</p><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#listingModal">Add a listing</button></div>
    <% } %>
  </section>

  <section class="dashboard-section mb-5">
    <div class="mb-3"><span class="eyebrow">From your community</span><h2 class="h5 fw-semibold mt-1 mb-0">Requests for your items</h2></div>
    <% if (receivedRequests.length) { %>
      <div class="request-list">
        <% receivedRequests.forEach(request => { %><article class="request-card">
          <div class="request-copy"><a href="/items/<%= request.listing_id %>" class="table-item-link"><strong><%= request.listing_title %></strong></a><span>Requested by <%= request.borrower_name %></span><span><%= request.request_from.toISOString().slice(0,10) %> – <%= request.request_to.toISOString().slice(0,10) %></span><% if (request.message) { %><p class="request-message">“<%= request.message %>”</p><% } %></div>
          <div class="request-actions"><span class="status-pill status-<%= request.status %>"><%= request.status %></span>
            <% if (request.status === 'pending') { %>
              <form action="/requests/<%= request.id %>/status" method="post"><input type="hidden" name="action" value="approve"><button class="btn btn-sm btn-primary" type="submit">Approve</button></form>
              <form action="/requests/<%= request.id %>/status" method="post"><input type="hidden" name="action" value="decline"><button class="btn btn-sm btn-outline-secondary" type="submit">Decline</button></form>
            <% } else if (request.status === 'approved') { %>
              <form action="/requests/<%= request.id %>/status" method="post"><input type="hidden" name="action" value="return"><button class="btn btn-sm btn-outline-primary" type="submit">Mark returned</button></form>
            <% } %>
          </div>
        </article><% }) %>
      </div>
    <% } else { %><div class="surface-card p-4 text-secondary small">No requests yet. They’ll show up here when a student asks to borrow one of your items.</div><% } %>
  </section>

  <section class="dashboard-section">
    <div class="mb-3"><span class="eyebrow">Your activity</span><h2 class="h5 fw-semibold mt-1 mb-0">Items you requested</h2></div>
    <% if (sentRequests.length) { %>
      <div class="request-list">
        <% sentRequests.forEach(request => { %><article class="request-card">
          <div class="request-copy"><a href="/items/<%= request.listing_id %>" class="table-item-link"><strong><%= request.listing_title %></strong></a><span>Owner: <%= request.owner_name %></span><span><%= request.request_from.toISOString().slice(0,10) %> – <%= request.request_to.toISOString().slice(0,10) %></span></div>
          <div class="request-actions"><span class="status-pill status-<%= request.status %>"><%= request.status %></span><% if (request.status === 'pending') { %><form action="/requests/<%= request.id %>/cancel" method="post"><button class="btn btn-sm btn-outline-secondary" type="submit">Cancel request</button></form><% } %></div>
        </article><% }) %>
      </div>
    <% } else { %><div class="surface-card p-4 text-secondary small">You haven't requested an item yet. <a href="/items">Explore what's available</a>.</div><% } %>
  </section>
</main>

<div class="modal fade" id="listingModal" tabindex="-1" aria-labelledby="listingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><div><span class="eyebrow">Share with your campus</span><h2 class="modal-title fs-5 mt-1" id="listingModalLabel">Add a listing</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <form action="/listings" method="post" enctype="multipart/form-data">
      <div class="modal-body">
        <div class="mb-3"><label class="form-label" for="title">Item name</label><input class="form-control" id="title" name="title" maxlength="120" placeholder="e.g. Scientific calculator" required></div>
        <div class="row g-3"><div class="col-sm-6"><label class="form-label" for="category">Category</label><select class="form-select" id="category" name="category" required><option value="">Choose one</option><% ['Study','Electronics','Books','Sports','Lab','Other'].forEach(category => { %><option value="<%= category %>"><%= category %></option><% }) %></select></div>
        <div class="col-sm-6"><label class="form-label" for="condition">Condition</label><select class="form-select" id="condition" name="condition" required><option value="Good">Good</option><option value="Like new">Like new</option><option value="Fair">Fair</option></select></div></div>
        <div class="mb-3 mt-3"><label class="form-label" for="price">Price per day (₹)</label><input class="form-control" id="price" name="price_per_day" type="number" min="0" max="100000" step="0.01" value="0" required><div class="form-text">Enter 0 if you’re happy to lend it for free.</div></div>
        <div class="mb-3"><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" rows="3" maxlength="2000" placeholder="Condition, pickup details, or anything else useful..."></textarea></div>
        <div><label class="form-label" for="image">Item photo <span class="text-secondary fw-normal">(max 5 MB)</span></label><input class="form-control" id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp" required><div class="form-text">Required. JPG, PNG, or WebP.</div></div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Publish listing</button></div>
    </form>
  </div></div>
</div>
<%- include("partials/footer") %>
