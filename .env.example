PORT=3000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# Local MySQL connection. Run npm run db:setup after configuring MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=borrowloop
MYSQL_USER=borrowloop_app
MYSQL_PASSWORD=change-me
MYSQL_POOL_MAX=10

# Optional Gemini-powered natural-language search.
# Create a key in Google AI Studio and keep it private in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
